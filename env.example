# Thakii Worker Service Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_KEY=/path/to/your/firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/firebase-service-account.json

# AWS S3 Configuration  
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-2
S3_BUCKET_NAME=thakii-video-storage-1753883631

# Worker Configuration
WORKER_POLL_INTERVAL=10
MAX_CONCURRENT_TASKS=3
TEMP_DIR=/tmp/thakii-worker

# PDF Generation Configuration
# Video Analysis Parameters

VIDEO_THRESHOLD=15
# Pixel difference threshold for scene detection (0-255 scale)
# Lower values = more sensitive to color changes
# Default: 15

MIN_SEGMENT_DURATION=2000
# Minimum duration between segments in milliseconds
# Filters out very short scene changes (noise/glitches)
# Default: 2000 (2 seconds)

MAX_SEGMENTS=
# Optional: Maximum number of PDF pages/segments to generate
# If not set, unlimited pages based on detected scenes
# Recommended for production: Set to 20-50 to prevent huge PDFs
# Default: Not set (unlimited)

# Note: Scene detection uses logarithmic threshold automatically
# Formula: 15 * log10(duration_seconds) % of total pixels
# Example: 100s video → 30% threshold, 800s video → 43.6% threshold

# Whisper AI Parameters
WHISPER_COMPRESSION_THRESHOLD=2.4
WHISPER_LOGPROB_THRESHOLD=-1.0
WHISPER_NO_SPEECH_THRESHOLD=0.6

# PDF Layout Parameters
PDF_FONT_SIZE=12
PDF_FONT_NAME=DejaVuSansCondensed

# Subtitle Generation Parameters
MAX_SUBTITLE_SEGMENTS=8
MIN_SUBTITLE_DURATION=8000

# Development/Testing Configuration
DISABLE_FIREBASE=false
DISABLE_S3=false
DEBUG_MODE=false

# Optional: Override default paths
# FONTS_PATH=./fonts
# TEST_VIDEO_PATH=./test.mp4
